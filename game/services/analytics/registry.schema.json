{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-of-words:analytics-registry:v1",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "additionalProperties": {
    "type": "object",
    "required": [
      "params",
      "description"
    ],
    "additionalProperties": false,
    "properties": {
      "description": {
        "type": "string",
        "pattern": "\\S"
      },
      "params": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "additionalProperties": {
          "enum": [
            "int",
            "float",
            "bool",
            "string"
          ]
        }
      }
    }
  }
}
