; Engine configuration file. Godot 4.7.2-stable (decision 0001). Hotspot: infra/contract tasks only.

config_version=5

[application]

config/name="World of Words"
run/main_scene="res://services/nav/boot.tscn"
config/version="0.1.0"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Config="*res://services/config.gd"
Save="*res://services/save.gd"
Progress="*res://services/progress.gd"
Economy="*res://services/economy.gd"
Daily="*res://services/daily.gd"
Content="*res://services/content.gd"
Monetization="*res://services/monetization.gd"
Analytics="*res://services/analytics.gd"
Audio="*res://services/audio.gd"
Nav="*res://services/nav.gd"
Events="*res://services/events.gd"
Platform="*res://platform/platform.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inference_on_variant=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
