{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-of-words:manifest:v1",
  "title": "P1-compatible Polish manifest with additive 1.1 metadata",
  "type": "object",
  "required": [
    "schema_version",
    "lang",
    "content_version",
    "pipeline",
    "slots",
    "packs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "lang": {
      "const": "pl"
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "pipeline": {
      "$ref": "urn:world-of-words:level:v1#/$defs/semver"
    },
    "slots": {
      "type": "integer",
      "minimum": 1
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "kind",
          "first",
          "last",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^packs/c-[0-9]{4,5}-[0-9]{4,5}\\.json$(?![\\s\\S])"
          },
          "kind": {
            "const": "campaign"
          },
          "first": {
            "type": "integer",
            "minimum": 1
          },
          "last": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$(?![\\s\\S])"
          }
        }
      }
    },
    "daily": {
      "type": "null"
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name_key",
          "first",
          "last"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
          },
          "name_key": {
            "type": "string",
            "pattern": "^journey\\.region\\.[a-z][a-z0-9_]*$(?![\\s\\S])"
          },
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "last": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "region",
          "name_key",
          "first",
          "last",
          "postcard",
          "pieces"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
          },
          "region": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
          },
          "name_key": {
            "type": "string",
            "pattern": "^journey\\.location\\.[a-z][a-z0-9_]*$(?![\\s\\S])"
          },
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "last": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "postcard": {
            "type": "string",
            "pattern": "^postcards/[a-z0-9_-]+\\.webp$(?![\\s\\S])"
          },
          "pieces": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slot",
          "landmark"
        ],
        "additionalProperties": false,
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "landmark": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "regions"
        ]
      },
      "then": {
        "required": [
          "regions",
          "locations",
          "landmarks"
        ]
      }
    },
    {
      "if": {
        "required": [
          "locations"
        ]
      },
      "then": {
        "required": [
          "regions",
          "locations",
          "landmarks"
        ]
      }
    },
    {
      "if": {
        "required": [
          "landmarks"
        ]
      },
      "then": {
        "required": [
          "regions",
          "locations",
          "landmarks"
        ]
      }
    }
  ]
}
